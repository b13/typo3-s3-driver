{
	"name": "b13/typo3-s3-driver",
	"type": "typo3-cms-extension",
	"description": "S3 Driver - Amazon S3 and S3-compatible object storages (MinIO, Cloudflare R2, Hetzner, DigitalOcean Spaces, Wasabi) as TYPO3 file storages, based on the Flysystem drivers of TYPO3 v15.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"TYPO3 CMS",
		"FAL",
		"file storage",
		"S3",
		"Amazon S3",
		"MinIO",
		"Cloudflare R2",
		"Flysystem"
	],
	"homepage": "https://b13.com",
	"authors": [
		{
			"name": "b13 GmbH",
			"email": "typo3@b13.com",
			"homepage": "https://b13.com",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/b13/typo3-s3-driver/issues",
		"source": "https://github.com/b13/typo3-s3-driver"
	},
	"require": {
		"php": "^8.5",
		"league/flysystem-aws-s3-v3": "^3.29",
		"typo3/cms-core": "^15.0"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"typo3/coding-standards": "^0.5.5",
		"typo3/testing-framework": "dev-main"
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"sort-packages": true
	},
	"autoload": {
		"psr-4": {
			"B13\\S3Driver\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"B13\\S3Driver\\Tests\\": "Tests/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "s3_driver",
			"web-dir": ".Build/Web",
			"app-dir": ".Build",
			"version": "0.1.0",
			"Package": {
				"providesPackages": {}
			}
		}
	}
}
